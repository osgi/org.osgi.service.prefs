                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>key</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>key whose associated value is to be returned as an {@code int}
        .</fo:block>
