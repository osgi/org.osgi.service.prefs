                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Returns this node's absolute path name. Note that:
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d206e720">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d206e721">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>Root node - The path name of the root node is {@code "/"}.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d206e723">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>Slash at end - Path names other than that of the root node may not
 end in slash ({@code '/'}).</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d206e725">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>Unusual names -{@code "."} and {@code ".."} have <fo:inline font-style="italic">no</fo:inline> special
 significance in path names.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d206e730">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>Illegal names - The only illegal path names are those that contain
 multiple consecutive slashes, or that end in slash and are not the root.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
