               <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell number-columns-spanned="3">
                        <fo:block line-height="0pt" text-align-last="justify">
                           <fo:inline baseline-shift="5pt">
                              <fo:leader leader-length="1in - 0.090in" leader-pattern="rule"/>
                              <fo:leader leader-length="0.090in" leader-pattern="space"/>
                              <fo:leader leader-pattern="rule"/>
                           </fo:inline>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
                  <fo:table-row block-progression-dimension.minimum="9pt">
                     <fo:table-cell text-align="start" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block>Page <fo:page-number/>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="center" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block/>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="end" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block>OSGi Specification repo for org.osgi.service.prefs</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
      </fo:static-content>
      <fo:static-content flow-name="xsl-region-after-blank">
         <fo:block font-family="ProductusBook,ArialUnicodeMS"
                   margin-left="0pt"
                   font-size="9pt"
                   line-height="9pt"
                   font-weight="normal"
                   hyphenate="false"
                   letter-spacing="0.03em">
            <fo:table xmlns:d="http://docbook.org/ns/docbook"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                      table-layout="fixed"
                      width="100%">
               <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
               <fo:table-column column-number="2" column-width="proportional-column-width(0)"/>
               <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell number-columns-spanned="3">
                        <fo:block line-height="0pt" text-align-last="justify">
                           <fo:inline baseline-shift="5pt">
                              <fo:leader leader-length="1in - 0.090in" leader-pattern="rule"/>
                              <fo:leader leader-length="0.090in" leader-pattern="space"/>
                              <fo:leader leader-pattern="rule"/>
                           </fo:inline>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
                  <fo:table-row block-progression-dimension.minimum="9pt">
                     <fo:table-cell text-align="start" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block>Page <fo:page-number/>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="center" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block/>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="end" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block>OSGi Specification repo for org.osgi.service.prefs</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.prefs">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>106</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>PreferencesService Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.prefs">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.1</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d206e87">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>106.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Many bundles need to save some data persistently - in other words,
    the data is required to survive the stopping and restarting of the bundle
    and OSGi Framework. In some cases, the data is specific to a particular
    user. For example, imagine a bundle that implements some kind of game.
    User specific persistent data could include things like the user's
    preferred difficulty level for playing the game. Some data is not specific
    to a user, which we call <fo:inline font-style="italic">system</fo:inline> data. An example
    would be a table of high scores for the game.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Bundles which need to persist data in an OSGi environment can use
    the file system via
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">org.osgi.framework.BundleContext.getDataFile</fo:inline>. A file system,
    however, can store only bytes and characters, and provides no direct
    support for named values and different data types.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A popular class used to address this problem for Java applications
    is the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">java.util.Properties</fo:inline> class. This class allows data to
    be stored as key/value pairs, called <fo:inline font-style="italic">properties</fo:inline>. For
    example, a property could have a name <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">com.acme.fudd</fo:inline> and a
    value of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">elmer</fo:inline>. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Properties</fo:inline> class has
    rudimentary support for storage and retrieving with its <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">load</fo:inline>
    and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">store</fo:inline> methods. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Properties</fo:inline> class,
    however, has the following limitations:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d206e116">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e117">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Does not support a naming hierarchy.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e119">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Only supports <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">String</fo:inline> property values.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e124">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Does not allow its content to be easily stored in a back-end
        system.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e126">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Has no user name-space management.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Since the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Properties</fo:inline> class was introduced in Java 1.0,
    efforts have been undertaken to replace it with a more sophisticated
    mechanism. One of these efforts is this Preferences Service
    specification.</fo:block>
            <fo:block id="d206e132">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Essentials</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The focus of this specification is simplicity, not reliable access
      to stored data. This specification does <fo:inline font-style="italic">not</fo:inline> define
      a general database service with transactions and atomicity guarantees.
      Instead, it is optimized to deliver the stored information when needed,
      but it will return defaults, instead of throwing an exception, when the
      back-end store is not available. This approach may reduce the
      reliability of the data, but it makes the service easier to use, and
      allows for a variety of compact and efficient implementations.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This API is made easier to use by the fact that many bundles can
      be written to ignore any problems that the Preferences Service may have
      in accessing the back-end store, if there is one. These bundles will
      mostly or exclusively use the methods of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline>
      interface which are not declared to throw a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">BackingStoreException</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:inline font-style="italic">This service only supports the storage of scalar values
      and byte arrays</fo:inline>. It is not intended for storing large data
      objects like documents or images. No standard limits are placed on the
      size of data objects which can be stored, but implementations are
      expected to be optimized for the handling of small objects.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A hierarchical naming model is supported, in contrast to the flat
      model of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Properties</fo:inline> class. A hierarchical model maps
      naturally to many computing problems. For example, maintaining
      information about the positions of adjustable seats in a car requires
      information for each seat. In a hierarchy, this information can be
      modeled as a node per seat.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A potential benefit of the Preferences Service is that it allows
      user specific preferences data to be kept in a well defined place, so
      that a user management system could locate it. This benefit could be
      useful for such operations as cleaning up files when a user is removed
      from the system, or to allow a user's preferences to be cloned for a new
      user.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Preferences Service does <fo:inline font-style="italic">not</fo:inline> provide a
      mechanism to allow one bundle to access the preferences data of another.
      If a bundle wishes to allow another bundle to access its preferences
      data, it can pass a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Preferences</fo:inline>
                  </fo:basic-link> or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.PreferencesService">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">PreferencesService</fo:inline>
                  </fo:basic-link> object to that bundle.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Preferences Service is not intended to provide configuration
      management functionality. For information regarding Configuration
      Management, refer to the <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>.</fo:block>
            </fo:block>
            <fo:block id="d206e164">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.1.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">PreferencesService</fo:inline> is a relatively simple
      service. It provides access to the different roots of Preferences trees.
      A single system root node and any number of user root nodes are
      supported. Each <fo:inline font-style="italic">node</fo:inline> of such a tree is an object
      that implements the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> interface.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> interface provides methods for
      traversing the tree, as well as methods for accessing the properties of
      the node. This interface also contains the methods to flush data into
      persistent storage, and to synchronize the in-memory data cache with the
      persistent storage.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All nodes except root nodes have a parent. Nodes can have multiple
      children.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="i1423659">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 106.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Preferences Class Diagram</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d206e181" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.prefs/spec/org.osgi.spec.service.prefs/src/main/resources/spec/prefs-classes.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="7.000in"
                                          content-height="3.444in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d206e184">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.1.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Operation</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The purpose of the Preferences Service specification is to allow
      bundles to store and retrieve properties stored in a tree of nodes,
      where each node implements the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> interface. The
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">PreferencesService</fo:inline> interface allows a bundle to create or
      obtain a Preferences tree for system properties, as well as a
      Preferences tree for each user of the bundle.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This specification allows for implementations where the data is
      stored locally on the Framework or remotely on a back-end system.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d206e193">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Preferences Interface</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>106.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Preferences Interface</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Preferences</fo:inline> is an interface that defines the methods to
    manipulate a node and the tree to which it belongs. A
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Preferences</fo:inline> object contains:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d206e200">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e201">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A set of properties in the form of key/value pairs.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e203">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A parent node.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e205">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A number of child nodes.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block id="d206e207">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Hierarchies</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A valid <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> object always belongs to a
      <fo:inline font-style="italic">tree</fo:inline>. A tree is identified by its root node. In
      such a tree, a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> object always has a single
      parent, except for a root node which has a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>
      parent.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The root node of a tree can be found by recursively calling the
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.parent--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">parent()</fo:inline>
                  </fo:basic-link> method of a node until <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline> is
      returned. The nodes that are traversed this way are called the
      <fo:inline font-style="italic">ancestors</fo:inline> of a node.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each Preferences object has a private name-space for child nodes.
      Each child node has a name that must be unique among its siblings. Child
      nodes are created by getting a child node with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.node-String-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">node(String)</fo:inline>
                  </fo:basic-link> method. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> argument of this
      call contains a path name. Path names are explained in the next
      section.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Child nodes can have child nodes recursively. These objects are
      called the <fo:inline font-style="italic">descendants</fo:inline> of a node.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Descendants are automatically created when they are obtained from
      a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> object, including any intermediate nodes that
      are necessary for the given path. If this automatic creation is not
      desired, the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.nodeExists-String-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">nodeExists(String)</fo:inline>
                  </fo:basic-link> method can be used to determine if a node
      already exists.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="d206e243">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 106.2</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Categorization of nodes in a tree</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d206e245" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.prefs/spec/org.osgi.spec.service.prefs/src/main/resources/spec/node-categorization.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="6.499in"
                                          content-height="1.500in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d206e248">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Naming</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each node has a name relative to its parent. A name may consist of
      Unicode characters except for the solidus (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">'/' \u002F</fo:inline>).
      There are no special names, like <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">".."</fo:inline> or
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">"."</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Empty names are reserved for root nodes. Node names that are
      directly created by a bundle must <fo:inline font-style="italic">always</fo:inline> contain at
      least one character.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Preferences node names and property keys are <fo:inline font-style="italic">case
      sensitive</fo:inline>: for example, "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi"</fo:inline> and
      "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">oRg.oSgI</fo:inline>" are two distinct names.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Preferences Service supports different roots, so there is no
      absolute root for the Preferences Service. This concept is similar to
      the Windows Registry that also supports a number of roots.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A path consists of one or more node names, separated by a solidus
      (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">'/' \u002F</fo:inline>). Paths beginning with a solidus (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">'/'
      \u002F</fo:inline>) are called <fo:inline font-style="italic">absolute paths</fo:inline> while
      other paths are called <fo:inline font-style="italic">relative paths</fo:inline>. Paths cannot
      end with a solidus (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">'/' \u002F</fo:inline>) except for the special case
      of the root node which has absolute path <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">"/"</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Path names are always associated with a specific node; this node
      is called the current node in the following descriptions. Paths identify
      nodes as follows.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d206e287">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e288">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Absolute path</fo:inline> - The first
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">"/"</fo:inline> is removed from the path, and the remainder of the
          path is interpreted as a relative path from the tree's root
          node.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e294">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Relative path</fo:inline> -</fo:block>
                           <fo:list-block provisional-label-separation="0.2em"
                                          provisional-distance-between-starts="12pt"
                                          id="d206e298">
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d206e299">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>If the path is the empty string, it identifies the current
              node.</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d206e301">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>If the path is a name (does not contain a
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                     font-size="9pt"
                                                     letter-spacing="0.08em">"/"</fo:inline>), then it identifies the child node with that
              name.</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d206e306">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>Otherwise, the first name from the path identifies a child
              of the current node. The name and solidus (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                     font-size="9pt"
                                                     letter-spacing="0.08em">'/'
              \u002F</fo:inline>) are then removed from the path, and the remainder
              of the path is interpreted as a relative path from the child
              node.</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                           </fo:list-block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d206e311">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Tree Traversal Methods</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A tree can be traversed and modified with the following
      methods:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d206e314">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e315">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.childrenNames--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">childrenNames()</fo:inline>
                              </fo:basic-link> - Returns the names of the child
          nodes.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e319">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.parent--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">parent()</fo:inline>
                              </fo:basic-link> - Returns the parent node.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e323">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.removeNode--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">removeNode()</fo:inline>
                              </fo:basic-link> - Removes this node and all its
          descendants.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e327">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.node-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">node(String)</fo:inline>
                              </fo:basic-link> - Returns a Preferences object, which is
          created if it does not already exist. The parameter is an absolute
          or relative path.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e331">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.nodeExists-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">nodeExists(String)</fo:inline>
                              </fo:basic-link> - Returns true if the Preferences object
          identified by the path parameter exists.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d206e335">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Properties</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each Preferences node has a set of key/value pairs called
      properties. These properties consist of:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d206e338">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e339">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Key</fo:inline> - A key is a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
          object and <fo:inline font-style="italic">case sensitive.</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e346">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The name-space of these keys is separate from that of the
          child nodes. A Preferences node could have both a child node named
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">fudd</fo:inline> and a property named <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">fudd</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e353">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Value</fo:inline> - A value can always be stored and
          retrieved as a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline> object. Therefore, it must be
          possible to encode/decode all values into/from <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
          objects (though it is not required to store them as such, an
          implementation is free to store and retrieve the value in any
          possible way as long as the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline> semantics are
          maintained). A number of methods are available to store and retrieve
          values as primitive types. These methods are provided both for the
          convenience of the user of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Preferences</fo:inline> interface,
          and to allow an implementation the option of storing the values in a
          more compact form.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All the keys that are defined in a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> object
      can be obtained with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.keys--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">keys()</fo:inline>
                  </fo:basic-link> method. The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.clear--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">clear()</fo:inline>
                  </fo:basic-link> method can be used to clear all properties from
      a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> object. A single property can be removed with
      the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.prefs.Preferences.remove-String-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">remove(String)</fo:inline>
                  </fo:basic-link> method.</fo:block>
            </fo:block>
            <fo:block id="d206e377">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Storing and Retrieving Properties</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Preferences</fo:inline> interface has a number of methods for
      storing and retrieving property values based on their key. All the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">put*</fo:inline> methods take as parameters a key and a value. All the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">get*</fo:inline> methods take as parameters a key and a default
      value.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d206e387">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e388">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.put-String-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">put(String,String)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.get-String-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">get(String,String)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e393">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putBoolean-String-boolean-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putBoolean(String,boolean)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getBoolean-String-boolean-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getBoolean(String,boolean)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e398">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putInt-String-int-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putInt(String,int)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getInt-String-int-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getInt(String,int)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e403">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putLong-String-long-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putLong(String,long)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getLong-String-long-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getLong(String,long)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e408">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putFloat-String-float-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putFloat(String,float)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getFloat-String-float-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getFloat(String,float)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e413">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putDouble-String-double-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putDouble(String,double)</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getDouble-String-double-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getDouble(String,double)</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e418">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.putByteArray-String-byte---">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">putByteArray(String,byte[])</fo:inline>
                              </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.prefs.Preferences.getByteArray-String-byte---">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getByteArray(String,byte[])</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The methods act as if all the values are stored as
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> objects, even though implementations may use
      different representations for the different types. For example, a
      property can be written as a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> object and read back as
      a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">float</fo:inline>, providing that the string can be parsed as a valid
      Java <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">float</fo:inline> object. In the event of a parsing error, the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">get*</fo:inline> methods do not raise exceptions, but instead return
      their default parameters.</fo:block>
            </fo:block>
            <fo:block id="d206e435">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>106.2.6</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Defaults</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">get*</fo:inline> methods take a default value as a parameter.
      The reasons for having such a default are:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d206e441">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e442">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>When a property for a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Preferences</fo:inline> object has not
          been set, the default is returned instead. In most cases, the bundle
          developer does not have to distinguish whether or not a property
          exists.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d206e447">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>A <fo:inline font-style="italic">best effort</fo:inline> strategy has been a
          specific design choice for this specification. The bundle developer
          should not have to react when the back-end store is not available.
          In those cases, the default value is returned without further
          notice.</fo:block>
                           <fo:block space-before.optimum="5pt"
                                     space-before.minimum="5pt"
                                     space-before.maximum="5pt">Bundle developers who want to assure that the back-end store
          is available should call the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">flush</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">sync</fo:inline>
          method. Either of these methods will throw a
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">BackingStoreException</fo:inline> if the back-end store is not
          available.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
         </fo:block>
         <fo:block id="d206e460">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Concurrency</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>106.3</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Concurrency</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification specifically allows an implementation to modify
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Preferences</fo:inline> objects in a back-end store. If the back-end
    store is shared by multiple processes, concurrent updates may cause
    differences between the back-end store and the in-memory
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Preferences</fo:inline> objects.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Bundle developers can partly control this concurrency with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.prefs.Preferences.flush--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">flush()</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.prefs.Preferences.sync--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">sync()</fo:inline>
               </fo:basic-link> method. Both methods operate on a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Preferences</fo:inline> object.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">flush</fo:inline> method performs the following actions:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d206e480">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e481">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Stores (makes persistent) any ancestors (including the current
        node) that do not exist in the persistent store.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e483">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Stores any properties which have been modified in this node
        since the last time it was flushed.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e485">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Removes from the persistent store any child nodes that were
        removed from this object since the last time it was flushed.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e487">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Flushes all existing child nodes.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">sync</fo:inline> method will first flush, and then ensure that
    any changes that have been made to the current node and its descendants in
    the back-end store (by some other process) take effect. For example, it
    could fetch all the descendants into a local cache, or it could clear all
    the descendants from the cache so that they will be read from the back-end
    store as required.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If either method fails, a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">BackingStoreException</fo:inline> is
    thrown.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">flush</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">sync</fo:inline> methods provide no
    atomicity guarantee. When updates to the same back-end store are done
    concurrently by two different processes, the result may be that changes
    made by different processes are intermingled. To avoid this problem,
    implementations may simply provide a dedicated section (or name-space) in
    the back-end store for each OSGi environment, so that clashes do not
    arise, in which case there is no reason for bundle programmers to ever
    call <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">sync</fo:inline>.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In cases where <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">sync</fo:inline> is used, the bundle programmer
    needs to take into account that changes from different processes may
    become intermingled, and the level of granularity that can be assumed is
    the individual property level. Hence, for example, if two properties need
    to be kept in lockstep, so that one should not be changed without a
    corresponding change to the other, consider combining them into a single
    property, which would then need to be parsed into its two constituent
    parts.</fo:block>
         </fo:block>
         <fo:block id="d206e509">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">PreferencesService Interface</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>106.4</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>PreferencesService Interface</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">PreferencesService</fo:inline> is obtained from the Framework's
    service registry in the normal way. Its purpose is to provide access to
    Preferences root nodes.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Preferences Service maintains a system root and a number of user
    roots. User roots are automatically created, if necessary, when they are
    requested. Roots are maintained on a per bundle basis. For example, a user
    root called <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">elmer</fo:inline> in one bundle is distinct from a user root
    with the same name in another bundle. Also, each bundle has its own system
    root. Implementations should use a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">ServiceFactory</fo:inline> service
    object to create a separate <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">PreferencesService</fo:inline> object for
    each bundle.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The precise description of <fo:inline font-style="italic">user</fo:inline> and
    <fo:inline font-style="italic">system</fo:inline> will vary from one bundle to another. The
    Preference Service only provides a mechanism, the bundle may use this
    mechanism in any desired way.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.prefs.PreferencesService">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PreferencesService</fo:inline>
               </fo:basic-link> interface has the following methods to access the
    system root and user roots:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d206e533">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e534">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.prefs.PreferencesService.getSystemPreferences--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getSystemPreferences()</fo:inline>
                           </fo:basic-link> - Return a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Preferences</fo:inline> object
        that is the root of the system preferences tree.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e540">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.prefs.PreferencesService.getUserPreferences-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getUserPreferences(String)</fo:inline>
                           </fo:basic-link> - Return a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Preferences</fo:inline> object
        associated with the user name that is given as argument. If the user
        does not exist, a new root is created atomically.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d206e546">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.prefs.PreferencesService.getUsers--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getUsers()</fo:inline>
                           </fo:basic-link> - Return an array of the names of all the
        users for whom a Preferences tree exists.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block id="i1423660">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Cleanup</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>106.5</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Cleanup</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Preferences Service must listen for bundle uninstall events, and
    remove all the preferences data for the bundle that is being uninstalled.
    The Preferences Service must use the bundle id for the association and not
    the location.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">It also must handle the possibility of a bundle getting uninstalled
    while the Preferences Service is stopped. Therefore, it must check on
    startup whether preferences data exists for any bundle which is not
    currently installed. If it does, that data must be removed.</fo:block>
         </fo:block>
         <fo:block id="org.osgi.service.prefs">
            <fo:block>
               <fo:block>
